		{
			"name": "Delete",
			"description": "DELETE /service/:id — remove a service from state tracking.",
			"item": [
				{
					"name": "Delete service",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{dashgoat_host}}/service/host-1HTTP",
							"host": ["{{dashgoat_host}}"],
							"path": ["service", "host-1HTTP"]
						},
						"description": "Deletes the service state for host-1 / HTTP. Returns 204 on success, 404 if not found."
					},
					"response": []
				}
			]
