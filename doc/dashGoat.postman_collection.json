		{
			"name": "Alertmanager",
			"description": "POST /alertmanager/:urnkey — receive Prometheus Alertmanager webhooks.",
			"item": [
				{
					"name": "Alertmanager webhook (firing)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"{}:{alertname=\\\"HighErrorRate\\\"}\",\n  \"status\": \"firing\",\n  \"receiver\": \"dashgoat\",\n  \"groupLabels\": { \"alertname\": \"HighErrorRate\" },\n  \"commonLabels\": {\n    \"alertname\": \"HighErrorRate\",\n    \"severity\": \"error\",\n    \"namespace\": \"production\"\n  },\n  \"commonAnnotations\": { \"summary\": \"Error rate above threshold\" },\n  \"externalURL\": \"http://alertmanager:9093\",\n  \"alerts\": [\n    {\n      \"status\": \"firing\",\n      \"labels\": {\n        \"alertname\": \"HighErrorRate\",\n        \"namespace\": \"production\",\n        \"container\": \"api\"\n      },\n      \"annotations\": { \"summary\": \"Error rate above threshold\" },\n      \"startsAt\": \"2024-06-13T18:52:47Z\",\n      \"endsAt\": \"0001-01-01T00:00:00Z\",\n      \"generatorURL\": \"http://prometheus:9090/graph\"\n    }\n  ]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{dashgoat_host}}/alertmanager/{{dashgoat_urnkey}}",
							"host": ["{{dashgoat_host}}"],
							"path": ["alertmanager", "{{dashgoat_urnkey}}"]
						}
					},
					"response": []
				},
				{
					"name": "Alertmanager webhook (resolved)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"{}:{alertname=\\\"HighErrorRate\\\"}\",\n  \"status\": \"resolved\",\n  \"receiver\": \"dashgoat\",\n  \"groupLabels\": { \"alertname\": \"HighErrorRate\" },\n  \"commonLabels\": {\n    \"alertname\": \"HighErrorRate\",\n    \"severity\": \"error\",\n    \"namespace\": \"production\"\n  },\n  \"commonAnnotations\": { \"summary\": \"Error rate back to normal\" },\n  \"externalURL\": \"http://alertmanager:9093\",\n  \"alerts\": [\n    {\n      \"status\": \"resolved\",\n      \"labels\": {\n        \"alertname\": \"HighErrorRate\",\n        \"namespace\": \"production\",\n        \"container\": \"api\"\n      },\n      \"annotations\": { \"summary\": \"Error rate back to normal\" },\n      \"startsAt\": \"2024-06-13T18:52:47Z\",\n      \"endsAt\": \"2024-06-13T19:00:00Z\",\n      \"generatorURL\": \"http://prometheus:9090/graph\"\n    }\n  ]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{dashgoat_host}}/alertmanager/{{dashgoat_urnkey}}",
							"host": ["{{dashgoat_host}}"],
							"path": ["alertmanager", "{{dashgoat_urnkey}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Observability",
			"description": "Health check, Prometheus metrics, and metrics history.",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{dashgoat_host}}/health", "host": ["{{dashgoat_host}}"], "path": ["health"] },
						"description": "Returns 200 OK when ready, 503 otherwise. Response body includes version, uptime, and feature flags."
					},
					"response": []
				},
				{
					"name": "Prometheus metrics",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{dashgoat_host}}/metrics", "host": ["{{dashgoat_host}}"], "path": ["metrics"] },
						"description": "Exposes Prometheus metrics in text format."
					},
					"response": []
				},
				{
					"name": "Metrics history",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
						"url": {
							"raw": "{{dashgoat_host}}/metricshistory/host-1HTTP/24",
							"host": ["{{dashgoat_host}}"],
							"path": ["metricshistory", "host-1HTTP", "24"]
						},
						"description": "Fetches 24h of historical status for service ID host-1HTTP from Prometheus. Requires prometheusurl to be configured."
					},
					"response": []
				}
			]
		},
