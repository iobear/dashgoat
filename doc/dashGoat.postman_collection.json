{
	"info": {
		"_postman_id": "",
		"name": "dashGoat",
		"description": "dashGoat API collection. Set the collection variables before use:\n- `dashgoat_host`: base URL of your dashGoat instance\n- `dashgoat_updatekey`: write key for POST /update\n- `dashgoat_urnkey`: key for heartbeat and alertmanager endpoints\n- `dashgoat_buddy1` / `dashgoat_buddy2`: base URLs for buddy instances",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Status Updates",
			"description": "POST /update — submit or update the status of a host/service pair.",
			"item": [
				{
					"name": "Update ok",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"HTTP\",\n  \"status\": \"ok\",\n  \"message\": \"All good\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update info",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"HTTP\",\n  \"status\": \"info\",\n  \"message\": \"Informational\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update warning",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"HTTP\",\n  \"status\": \"warning\",\n  \"message\": \"Degraded performance\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update error",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"HTTP\",\n  \"status\": \"error\",\n  \"message\": \"Service failing\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update critical",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"HTTP\",\n  \"status\": \"critical\",\n  \"message\": \"Service down\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update with nextupdatesec (watchdog)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"rsync\",\n  \"status\": \"ok\",\n  \"message\": \"Backup completed\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\",\n  \"nextupdatesec\": 3600\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update with TTL (auto-resolve)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"uptime\",\n  \"status\": \"ok\",\n  \"message\": \"Server rebooted — message clears in 60s\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\",\n  \"ttl\": 60\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update with tags",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"nginx\",\n  \"status\": \"ok\",\n  \"message\": \"Serving traffic\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\",\n  \"tags\": [\"production\", \"uk\", \"customer\"]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update with dependon",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"nginx\",\n  \"status\": \"error\",\n  \"message\": \"No requests\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\",\n  \"dependon\": \"loadbalancer-1\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				},
				{
					"name": "Update full example",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"host\": \"host-1\",\n  \"service\": \"MyApp\",\n  \"status\": \"ok\",\n  \"message\": \"Running v2.3.1\",\n  \"severity\": \"info\",\n  \"updatekey\": \"{{dashgoat_updatekey}}\",\n  \"nextupdatesec\": 120,\n  \"ttl\": 600,\n  \"tags\": [\"production\", \"eu-west\"],\n  \"dependon\": \"database-1\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{dashgoat_host}}/update", "host": ["{{dashgoat_host}}"], "path": ["update"] }
					},
					"response": []
				}
			]
		},
		{
			"name": "Heartbeat",
			"description": "GET /heartbeat — lightweight keep-alive for devices where POST is not available.",
			"item": [
				{
					"name": "Heartbeat",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{dashgoat_host}}/heartbeat/{{dashgoat_urnkey}}/router01/60/router,home",
							"host": ["{{dashgoat_host}}"],
							"path": ["heartbeat", "{{dashgoat_urnkey}}", "router01", "60", "router,home"]
						},
						"description": "Sets host=router01 service=heartbeat to ok. Warns if no update arrives within 60s. Tags: router, home."
					},
					"response": []
				}
			]
		},
		{
			"name": "Read Status",
			"description": "Read-only endpoints — no authentication required.",
			"item": [
				{
					"name": "Status list (full)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
						"url": { "raw": "{{dashgoat_host}}/status/list", "host": ["{{dashgoat_host}}"], "path": ["status", "list"] },
						"description": "Returns all tracked service states keyed by {host}{service}."
					},
					"response": []
				},
				{
					"name": "Status list MSO (simplified)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
						"url": { "raw": "{{dashgoat_host}}/status/listmso", "host": ["{{dashgoat_host}}"], "path": ["status", "listmso"] },
						"description": "Returns a simplified {status, message} map for MSO/HPO integrations."
					},
					"response": []
				},
				{
					"name": "Status by ID",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
						"url": {
							"raw": "{{dashgoat_host}}/status/host-1HTTP",
							"host": ["{{dashgoat_host}}"],
							"path": ["status", "host-1HTTP"]
						},
						"description": "Returns the state for a single service. ID format: {host}{service}."
					},
					"response": []
				},
				{
					"name": "Search status",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
						"url": {
							"raw": "{{dashgoat_host}}/status/listsearch/nginx",
							"host": ["{{dashgoat_host}}"],
							"path": ["status", "listsearch", "nginx"]
						},
						"description": "Returns service states whose host or service name contains the search string."
					},
					"response": []
				}
			]
		},
